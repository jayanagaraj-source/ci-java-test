# Copy to .env and adjust. Every setting is read from the environment.

# --- Required -------------------------------------------------------------
# HMAC key for signing JWTs. At least 32 characters; startup fails otherwise.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# --- Server ---------------------------------------------------------------
PORT=8080
SHUTDOWN_TIMEOUT=20s
MAX_REQUEST_BODY_SIZE=64KB

# --- Auth -----------------------------------------------------------------
JWT_ISSUER=task-api
JWT_TTL=1h
BCRYPT_STRENGTH=12
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW=1m

# --- CORS (comma-separated allow-list; empty = no cross-origin access) -----
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (H2; defaults to in-memory) --------------------------------
DATABASE_URL=jdbc:h2:mem:taskdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DATABASE_USERNAME=sa
DATABASE_PASSWORD=

# --- Server-Sent Events ---------------------------------------------------
SSE_TIMEOUT=30m
SSE_HEARTBEAT=25s
SSE_MAX_CONNECTIONS_PER_USER=5

# --- Logging (structured console format: ecs | logstash | gelf) ----------
LOG_FORMAT=ecs
LOG_LEVEL=INFO
